# 실제 provider API를 호출할 때 사용할 provider를 선택합니다.
# openai 또는 anthropic 중 하나를 사용합니다.
# 비워 두면 openai가 기본값입니다.
AGENT_LEARNING_PROVIDER=openai

# 실제 OpenAI API를 호출할 때 사용할 API key입니다.
# 기본 테스트와 예제 실행은 fake model을 사용하므로 이 값이 없어도 동작합니다.
OPENAI_API_KEY=your-api-key

# OpenAI integration에서 사용할 chat model 이름입니다.
OPENAI_MODEL=gpt-4.1-mini

# OpenAI 호환 API endpoint를 사용할 때만 설정합니다.
# 기본 OpenAI endpoint를 사용할 경우 비워 둡니다.
OPENAI_BASE_URL=

# 실제 Anthropic API를 호출할 때 사용할 API key입니다.
# AGENT_LEARNING_PROVIDER=anthropic 일 때 사용합니다.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Anthropic integration에서 사용할 chat model 이름입니다.
ANTHROPIC_MODEL=claude-sonnet-4-6

# 0이면 외부 API를 호출하지 않고 fake fallback을 사용합니다.
# 실제 OpenAI 또는 Anthropic 호출을 확인할 때만 1로 바꿉니다.
RUN_AGENT_LEARNING_INTEGRATION=0
